{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compilar projeto",
      "type": "process",
      "command": "gcc",
      "args": [
        "-std=c11",
        "-Wall",
        "-Wextra",
        "-Wpedantic",
        "-I",
        "include",
        "main.c",
        "src\\menu.c",
        "src\\arvore.c",
        "src\\fila.c",
        "src\\processamento.c",
        "src\\inicializacao.c",
        "-o",
        "sistema-almoxarifado.exe"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$gcc",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Executar projeto",
      "type": "process",
      "command": "${workspaceFolder}\\sistema-almoxarifado.exe",
      "dependsOn": "Compilar projeto",
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Executar testes",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\tests\\executar-testes.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": "test"
    }
  ]
}
